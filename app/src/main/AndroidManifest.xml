<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Launcher must see every MAIN/LAUNCHER activity. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Optional: running.list. The OS only grants this from Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- LSPatch patched-APK sideload and fleet Install/Update. System confirm sheet required. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      No INTERNET permission. Status, pairing and backup talk to other on-device
      apps over Messenger. There is no telemetry endpoint.
    -->

    <queries>
        <package android:name="ai.droidcommand.app" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="org.lsposed.manager" />
        <package android:name="org.lsposed.lspd" />
        <package android:name="org.lsposed.lspatch" />
        <package android:name="com.android.geto" />
        <package android:name="com.dergoogler.mmrl" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="me.bmax.apatch" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="ai.droidcommand.app.action.BRIDGE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".VictorLaunchApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VictorLaunch"
        tools:targetApi="35">

        <activity
            android:name=".launcher.HomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.VictorLaunch.Home"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stock Shizuku binder (also works once the server is embedded). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Exported Messenger. Authorization is package+cert pairing, not a signature permission. -->
        <service
            android:name=".bridge.BridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.victorious.launch.action.BRIDGE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".island.IslandAdminReceiver"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".island.IslandCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.victorious.launch.action.ISLAND_CMD" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".mods.PatchedApkConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name=".fleet.FleetInstallConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".widgets.MeshVpnWidget"
            android:exported="true"
            android:label="@string/widget_mesh_vpn">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mesh_vpn" />
        </receiver>
        <receiver
            android:name=".widgets.BrowserWidget"
            android:exported="true"
            android:label="@string/widget_browser">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_browser" />
        </receiver>
        <receiver
            android:name=".widgets.MessagingWidget"
            android:exported="true"
            android:label="@string/widget_messaging">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_messaging" />
        </receiver>
        <receiver
            android:name=".widgets.HealthWidget"
            android:exported="true"
            android:label="@string/widget_health">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_health" />
        </receiver>
        <receiver
            android:name=".widgets.WidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.victorious.launch.action.WIDGET_REFRESH" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".island.IslandActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.victorious.launch.action.ISLAND_CMD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
