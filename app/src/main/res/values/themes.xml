<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VictorLaunch" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0B0C12</item>
        <item name="android:windowBackground">#0B0C12</item>
        <item name="android:colorPrimary">#00E5FF</item>
        <item name="android:colorAccent">#E840FF</item>
        <item name="android:textColorPrimary">#F5F7FF</item>
    </style>

    <style name="Theme.VictorLaunch.Home" parent="Theme.VictorLaunch">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>
</resources>
